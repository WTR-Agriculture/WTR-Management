# ============================================
# WTR Management - Environment Variables
# ============================================
# Copy this file to .env.local for development
# ============================================

# ============================================
# Application
# ============================================
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://wtr:wtr123@localhost:5432/wtr_dev
DB_USER=wtr
DB_PASSWORD=wtr123
DB_NAME=wtr_dev

# ============================================
# Authentication
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-secure-random-string-in-production
JWT_SECRET=change-this-to-a-secure-random-string-in-production
NEXTAUTH_URL=http://localhost:3000

# Access Token: 15 minutes
JWT_ACCESS_EXPIRES_IN=15m
# Refresh Token: 7 days
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Storage (S3-compatible)
# ============================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_PRIVATE=wtr-private
STORAGE_BUCKET_PUBLIC=wtr-public
STORAGE_REGION=auto

# For production with Cloudflare R2:
# STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL=https://pub-xxx.r2.dev

# ============================================
# MinIO Console (Development only)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ============================================
# n8n (Phase 3+)
# ============================================
# N8N_WEBHOOK_URL=http://localhost:5678
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=admin

# ============================================
# Worker (Future)
# ============================================
WORKER_ENABLED=false
WORKER_CONCURRENCY=5
WORKER_QUEUE=default
WORKER_POLL_INTERVAL=5000
# REDIS_URL=redis://localhost:6379

# ============================================
# Domain (Production)
# ============================================
# DOMAIN=wtr.example.com
# ACME_EMAIL=admin@example.com
